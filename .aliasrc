####################
##### SYSTEM #######
####################

#-------- Default programs {{{
#------------------------------------------------------

find_alt() {
  for i; do
    command -v "$i" >/dev/null 2>&1 && { echo "$i"; return 0; }
  done
  return 1
}

export OPENER
OPENER=$(find_alt xdg-open exo-open gnome-open)

export BROWSER BROWSERCLI BROWSERTOR EBOOKER
export EDITOR EDITORCLI EDITORGUI
export FILEMANAGER FILEMANAGERCLI PAGER PLAYER READER IMAGEVIEWER QUEUER

BROWSER=$(find_alt google-chrome-stable google-chrome chromium chromium-browser brave brave-browser firefox qutebrowser "$OPENER")
BROWSERCLI=$(find_alt w3m links2 links lynx elinks "$OPENER")
BROWSERTOR=$(find_alt tor-browser-en)
EBOOKER=$(find_alt ebook-viewer "$OPENER")
EDITOR=$(find_alt nvim vim vi nano "$OPENER")
EDITORCLI=$(find_alt nvim vim nano pico vi "$OPENER")
EDITORGUI=$(find_alt code subl mousepad leafpad gedit pluma "$OPENER")
FILEMANAGER=$(find_alt nemo nautilus thunar dolphin spacefm enlightenment_filemanager "$OPENER")
FILEMANAGERCLI=$(find_alt yazi ranger vifm mc "$OPENER")
PAGER=$(find_alt less more most)
PLAYER=$(find_alt mpv mplayer ffplay cvlc "$OPENER")
READER=$(find_alt mupdf zathura evince "$OPENER")
IMAGEVIEWER=$(find_alt sxiv feh ristretto display eog "$OPENER")
QUEUER=$(find_alt tsp fq ts)

# }}}

#-------- PATH (bash-only fallback; zsh uses ~/.zprofile) {{{
#------------------------------------------------------

if [ -z "${ZSH_VERSION:-}" ]; then
  for _p in \
    "$HOME/.local/bin" \
    "$HOME/.local/bin/scripts" \
    "$HOME/.cargo/bin" \
    "$HOME/.local/share/npm_global/bin" \
    "$HOME/.config/npm" \
    "$HOME/.opencode/bin"
  do
    [ -d "$_p" ] || continue
    case ":$PATH:" in
      *":$_p:"*) ;;
      *) PATH="$_p:$PATH" ;;
    esac
  done
  unset _p
  export PATH
fi

# }}}

#-------- Config editors {{{
#------------------------------------------------------

cfg-aliasrc() { $EDITORCLI ~/.aliasrc ;}
cfg-bashrc() { $EDITORCLI ~/.bashrc ;}
cfg-cava() { $EDITORCLI ~/.config/cava/config ;}
cfg-picom() { $EDITORCLI ~/.config/picom.conf ;}
cfg-fstab() { sudo $EDITORCLI /etc/fstab ;}
cfg-group() { sudo $EDITORCLI /etc/group ;}
cfg-hosts() { sudo $EDITORCLI /etc/hosts ;}
cfg-mpd() { $EDITORCLI ~/.mpd/mpd.conf ;}
cfg-mpv() { $EDITORCLI ~/.config/mpv/mpv.conf ;}
cfg-mpv-input() { $EDITORCLI ~/.config/mpv/input.conf ;}
cfg-nanorc() { $EDITORCLI ~/.nanorc ;}
cfg-ncmpcpp() { $EDITORCLI ~/.ncmpcpp/config ;}
cfg-profile() { $EDITORCLI ~/.profile ;}
cfg-ssh-client() { sudo $EDITORCLI /etc/ssh/ssh_config ;}
cfg-ssh-daemon() { sudo $EDITORCLI /etc/ssh/sshd_config ;}
cfg-sudoers() { sudo $EDITORCLI /etc/sudoers ;}
cfg-syncthing() { $EDITORCLI ~/.config/syncthing/config.xml ;}
cfg-tmuxrc() { $EDITORCLI ~/.config/tmux/tmux.conf.local ;}
cfg-updatedb() { sudo $EDITORCLI /etc/updatedb.conf ;}
cfg-vimrc() { $EDITORCLI ~/.vimrc ;}
cfg-xbindkeysrc() { $EDITORCLI ~/.xbindkeysrc && killall xbindkeys ; xbindkeys ;}
cfg-xresources() { $EDITORCLI ~/.Xresources ;}
cfg-zshrc() { $EDITORCLI ~/.zshrc ;}
cfg-zprezto() { $EDITORCLI ~/.zpreztorc ;}
cfg-zprofile() { $EDITORCLI ~/.zprofile ;}

# }}}

#-------- Config reload {{{
#------------------------------------------------------

rld-bashrc() { source ~/.bashrc ;}
rld-font() { fc-cache -v -f ;}
rld-grub() { sudo grub-mkconfig -o /boot/grub/grub.cfg ;}
rld-updatedb() { sudo updatedb ;}
rld-xbindkeys() { killall xbindkeys ; xbindkeys ;}
rld-keyblayout() { setxkbmap -layout latam -variant deadtilde ;}
rld-xresources() { xrdb -load ~/.Xresources ;}
rld-zshrc() { source ~/.zshrc ;}

# }}}

####################
##### ALIASES ######
####################

#-------- Navigation {{{
#------------------------------------------------------

# zoxide: optional cd override (can break scripts expecting real cd)
# alias cd='z'
alias old-cd='builtin cd'
# plain z from zoxide init; use: z <dir>  or uncomment alias above

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ......='cd ../../../../..'

# }}}

#-------- File ops {{{
#------------------------------------------------------

alias cp='cp -aiv'
alias mv='mv -iv'
alias mkdir='mkdir -p -v'
alias rmdir='rmdir -v'
alias ln='ln -iv'
alias derez='rm -Iv'
alias uhaul='mv -iv --'

alias ls='eza --icons --group-directories-first -x'
alias l='eza -x -a -s changed --icons --group-directories-first'
alias ll='eza -l --icons --group-directories-first'
alias la='eza -l -a -s changed --icons --group-directories-first'
alias lg='eza -l --icons --git -a'
alias lt='eza --icons --tree --level=2'

alias cat='bat'

# }}}

#-------- Command tweaks {{{
#------------------------------------------------------

alias bc='bc -q -l'
alias df='df -hT --total'
alias du='du -d1 -h'
alias feh='feh --auto-zoom --scale-down -g 1360x768 -B white'
alias free='free -h'
alias info='info --vi-keys'
alias lsblk='lsblk -o "KNAME,HOTPLUG,SIZE,FSTYPE,TYPE,LABEL,MOUNTPOINT,UUID,MODEL,SERIAL"'
alias nano='nano -c'
alias w3m='w3m -num'
alias wget='wget -N -c'
alias visudo='sudo EDITOR="$EDITOR" visudo'
alias ping='ping -c 5'

# renamed footguns (bare curl/mount stay stock)
alias curlget='curl -O -L'
alias mntls='mount | column -t'

alias fzfb='fzf --preview "bat --color=always {}"'
alias browser='$BROWSER'
alias privatebrowser='$BROWSER --incognito'
alias sshconfig='$EDITOR ~/.ssh/config'

# youtube: prefer yt-dlp when present
if command -v yt-dlp >/dev/null 2>&1; then
  alias yt='yt-dlp --add-metadata -i'
else
  alias yt='youtube-dl --add-metadata -i'
fi
alias yta='yt -x -f bestaudio/best'

alias neocrux='neofetch --ascii --ascii_distro crux_small'
alias neowin='neofetch --ascii --ascii_distro windows'

alias wttr='curl -s wttr.in'
alias wttr-help='curl -s wttr.in/:help'

alias btcprice='curl -s https://rate.sx/BTC'
alias ethprice='curl -s https://rate.sx/ETH'
alias zrxprice='curl -s https://rate.sx/ZRX'

alias long-time-no-update='sudo pacman -Sy archlinux-keyring --needed && sudo pacman -Su'
alias yeet='yay -Rns'
alias daty='date +%Y%m%d'
alias openports='ss -tulpn'
alias miclightoff='echo 0 | sudo tee /sys/class/leds/platform::micmute/brightness'

# }}}

#-------- Clipboard {{{
#------------------------------------------------------

alias pbcopy='xclip -selection clipboard'
alias pbpaste='xclip -selection clipboard -o'
alias pbselect='xclip -selection primary -o'
alias pbnoformatting='xclip -selection clipboard -o | xclip -selection clipboard'

# }}}

#-------- Dotfiles bare repo {{{
#------------------------------------------------------

alias dotfiles='/usr/bin/git --git-dir=$HOME/.dotfiles.git/ --work-tree=$HOME'

# }}}


####################
##### FUNCTIONS ####
####################

#-------- File helpers {{{
#------------------------------------------------------

mkdircd() { mkdir -p -v -- "$1" && cd -- "$1" || return; }
cpbak() { cp -a -- "$1" "$1.bak"; }
file-permission() { stat --format '%a %n' "$@"; }
file-type() { file --mime-type -b "$@"; }

up() {
  local x='' i
  for i in $(seq "${1:-1}"); do x="$x../"; done
  cd -- "$x" || return
}

# }}}

#-------- Network / share {{{
#------------------------------------------------------

down4me() {
  curl -s "http://downforeveryoneorjustme.com/$1" | sed '/just you/!d;s/<[^>]*>//g'
}

myip() { curl -s http://ipecho.net/plain; echo; }

pbupload-sprunge() {
  cat "$@" | curl -F 'sprunge=<-' http://sprunge.us | tee >(pbcopy)
  echo "URL copied to clipboard"
}

pbupload-ix() {
  cat "${1:--}" | curl -F 'f:1=<-' ix.io | tee >(pbcopy)
  echo "URL copied to clipboard"
}

0x0() {
  local logdir="${HOME}/.local/share/0x0"
  mkdir -p -- "$logdir"
  curl -F"file=@$1" https://0x0.st | tee -a "$logdir/0x0.log"
}

sshkey() {
  ssh-keygen -t ed25519 -C "$(whoami)@$(hostname)-$(date -I)"
}

# }}}

#-------- Utilities {{{
#------------------------------------------------------

disks() {
  echo "╓───── m o u n t . p o i n t s"
  echo "╙────────────────────────────────────── ─ ─ "
  lsblk -a
  echo
  echo "╓───── d i s k . u s a g e"
  echo "╙────────────────────────────────────── ─ ─ "
  df -h
}

cal3() {
  command cal -3m | grep -B6 -A6 --color -e " $(date +%e)" -e "^$(date +%e)"
}

fzfedit() {
  local f
  f=$(locate "$1" | fzf) || return
  [ -n "$f" ] && nvim -- "$f"
}

killall-zombies() {
  kill -HUP $(ps -A -ostat,ppid | awk '/[zZ]/ { print $2 }') 2>/dev/null
}

nohup-command() { nohup "$@" >/dev/null 2>&1 & }

open() { xdg-open "$@" >/dev/null 2>&1; }

mdless() { pandoc -s -f markdown -t man "$@" | groff -T utf8 -man | less; }

:h() { nvim +":h $1" +'wincmd o' +'nnoremap q :q!<CR>'; }

cmdfu-random() {
  echo -e "$(curl -sL https://www.commandlinefu.com/commands/random/json \
    | sed -re 's/.*,"command":"(.*)","summary":"([^"]+).*/\x1b[1;32m\2\n\n\x1b[1;33m\1\x1b[0m/g')\n"
}

webm2mp4() {
  local i
  for i in *.webm; do
    [ -e "$i" ] || continue
    ffmpeg -i "$i" -vf "crop=trunc(iw/2)*2:trunc(ih/2)*2" \
      -c:v libx264 -preset slow -crf 22 -c:a copy "${i%.*}.mp4"
  done
}

# }}}
