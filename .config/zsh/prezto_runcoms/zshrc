if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# zsh-abbr (after Prezto so bindings survive)
if [[ -d "/usr/share/zsh/plugins/zsh-abbr" ]]; then
  export ABBR_USER_ABBREVIATIONS_FILE="$HOME/.config/zsh-abbr/user-abbreviations"
  source "/usr/share/zsh/plugins/zsh-abbr/zsh-abbr.plugin.zsh"
fi

# Match rg bright-red highlight for standard grep.
export RG_GREP_MATCH_COLOR='1;31'
export GREP_COLOR="$RG_GREP_MATCH_COLOR"
export GREP_COLORS="ms=$RG_GREP_MATCH_COLOR:mc=$RG_GREP_MATCH_COLOR"

##
# FZF extras (prezto fzf: keybinds + completion + height/tmux)
##

export FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS \
--color=fg:#c0caf5,bg:#1a1b26,hl:#ff9e64 \
--color=fg+:#c0caf5,bg+:#292e42,hl+:#ff9e64 \
--color=info:#7aa2f7,prompt:#7dcfff,pointer:#7dcfff \
--color=marker:#9ece6a,spinner:#9ece6a,header:#9ece6a"

export FZF_DEFAULT_COMMAND="fd --hidden --strip-cwd-prefix --exclude .git"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type=d --hidden --strip-cwd-prefix --exclude .git"
export FZF_CTRL_T_OPTS="--preview 'bat -n --color=always --line-range :500 {}'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always {} | head -200'"

_fzf_compgen_path() {
  fd --hidden --exclude .git . "$1"
}

_fzf_compgen_dir() {
  fd --type=d --hidden --exclude .git . "$1"
}

_fzf_comprun() {
  local command=$1
  shift
  case "$command" in
    cd)           fzf --preview 'eza --tree --color=always {} | head -200' "$@" ;;
    export|unset) fzf --preview "eval 'echo \$'{}" "$@" ;;
    ssh)          fzf --preview 'dig {}' "$@" ;;
    *)            fzf --preview "bat -n --color=always --line-range :500 {}" "$@" ;;
  esac
}

[[ -f "$HOME/dev/gits/fzf-git.sh/fzf-git.sh" ]] && source "$HOME/dev/gits/fzf-git.sh/fzf-git.sh"

export BAT_THEME=tokyonight_night

##
# Aliases / functions
##

[[ -f ~/.aliasrc ]] && source "$HOME/.aliasrc"

if [[ -d "$HOME/.config/functions" ]]; then
  for f in "$HOME"/.config/functions/*(N); do
    source "$f"
  done
fi

##
# Tools (interactive only)
##

if [[ -o interactive ]]; then
  if (( $+commands[pay-respects] )) && [[ -t 0 ]]; then
    eval "$(pay-respects zsh --alias)"
  fi
  if (( $+commands[navi] )); then
    eval "$(navi widget zsh)"
  fi
fi

# Ruby gems (static path — avoids ruby fork every startup)
export GEM_HOME="$HOME/.local/share/gem/ruby/3.4.0"
[[ -d $GEM_HOME/bin ]] && path+=("$GEM_HOME/bin")

if [[ -f "$HOME/.config/warmind/cli/completion.zsh" ]]; then
  source "$HOME/.config/warmind/cli/completion.zsh"
fi
