# Personal functions

#-------- VPN (NetworkManager / wireguard) {{{

vpn-on() { nmcli con up "$1"; }

vpn-off() {
  local active_vpn
  active_vpn=$(nmcli -t -f NAME,TYPE con show --active | awk -F: '$2 ~ /wireguard|vpn/ {print $1; exit}')
  if [[ -n $active_vpn ]]; then
    nmcli con down "$active_vpn"
    echo "VPN : $active_vpn down"
  else
    echo "No active VPN connection found."
  fi
}

