#-------- systemctl service checklist {{{

rc() {
  systemctl list-unit-files --type=service \
    | sed 's/.service//g' \
    | sed '/static/d;/indirect/d;/systemd/d;/dbus-org/d;/canberra/d;/wpa_supplicant/d;/netctl/d;/rfkill/d;/krb5/d' \
    | tail -n+2 \
    | head -n -2 \
    | sed 's/\(^.*enabled.*$\)/[x] \1/; s/enabled//g' \
    | sed 's/\(^.*disabled.*$\)/[ ] \1/; s/disabled//g' \
    | sed 's/[ \t]*$//' \
    | while IFS= read -r line; do
        if [[ $line == *'[x]'* ]]; then
          printf '\033[0;32m%s\n' "$line"
        else
          printf '\033[1;30m%s\n' "$line"
        fi
      done
}

