#-------- Touchpad driver toggle {{{

touchpad-driver() {
  local xconf_dir="/etc/X11/xorg.conf.d"
  local synaptics_conf="30-synaptics-touchpad.conf"
  local libinput_conf="40-libinput-touchpad.conf"

  case "$1" in
    synaptics|syn)
      echo "[+] Switching to synaptics driver..."
      sudo rm -f "$xconf_dir/$libinput_conf" 2>/dev/null
      sudo tee "$xconf_dir/$synaptics_conf" >/dev/null <<'EOF'
Section "InputClass"
    Identifier "Synaptics TouchPad"
    Driver "synaptics"
    MatchIsTouchpad "on"
    MatchDevicePath "/dev/input/event*"
    Option "VertScrollDelta" "150"
    Option "HorizScrollDelta" "150"
    Option "VertTwoFingerScroll" "on"
    Option "HorizTwoFingerScroll" "on"
    Option "CoastingSpeed" "0"
    Option "PalmDetect" "on"
EndSection
EOF
      echo "[✓] Synaptics configured. Log out and back in to apply."
      ;;
    libinput|lib)
      echo "[+] Switching to libinput driver..."
      sudo rm -f "$xconf_dir/$synaptics_conf" 2>/dev/null
      sudo tee "$xconf_dir/$libinput_conf" >/dev/null <<'EOF'
Section "InputClass"
    Identifier "libinput touchpad catchall"
    Driver "libinput"
    MatchIsTouchpad "on"
    MatchDevicePath "/dev/input/event*"
    Option "ScrollMethod" "twofinger"
    Option "NaturalScrolling" "false"
    Option "AccelSpeed" "0"
    Option "Tapping" "on"
    Option "DisableWhileTyping" "on"
EndSection
EOF
      echo "[✓] Libinput configured. Log out and back in to apply."
      ;;
    status|st)
      if [ -f "$xconf_dir/$synaptics_conf" ]; then
        echo "[i] Current driver: synaptics ($xconf_dir/$synaptics_conf)"
      elif [ -f "$xconf_dir/$libinput_conf" ]; then
        echo "[i] Current driver: libinput ($xconf_dir/$libinput_conf)"
      else
        echo "[i] No custom touchpad config (system default, likely libinput)"
      fi
      ;;
    *)
      echo "Usage: touchpad-driver <synaptics|libinput|status>"
      return 1
      ;;
  esac
}

