#-------- Color / fun {{{

whodemon() {
  local f="$HOME/.config/functions/data/whodemon.txt"
  if [[ ! -f $f ]]; then
    echo "whodemon data missing: $f" >&2
    return 1
  fi
  shuf -n1 -- "$f"
}

colortest-gradients2() {
  echo -e '\033[m'
  local i f
  for i in {0..7}; do
    for f in {0..7}; do
      echo -en "\033[$((f + 30))m██▓▒░"
    done
    echo -e '\033[m'
  done
  echo -e '\033[m'
}

colortest-vbars() {
  clear
  local _term_width _term_height _bar_count _bar_width l b s
  _term_width=$(tput cols)
  _term_height=$(tput lines)
  _bar_count=8
  _bar_width=$((_term_width / _bar_count))
  l=1
  while [[ $l -lt $_term_height ]]; do
    b=0
    while [[ $b -lt $_bar_count ]]; do
      s=0
      while [[ $s -lt $_bar_width ]]; do
        echo -en "\033[3${b}m█"
        s=$((s + 1))
      done
      b=$((b + 1))
    done
    echo
    l=$((l + 1))
  done
}

