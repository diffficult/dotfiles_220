#-------- Calc / docs / search {{{

calc() {
  if command -v python3 >/dev/null 2>&1; then
    python3 -ic 'from math import *; import cmath'
  elif command -v bc >/dev/null 2>&1; then
    bc -q -l
  else
    echo "Need python3 or bc" >&2
    return 1
  fi
}

manned() {
  local arg
  for arg in "$@"; do
    man "$arg" 2>/dev/null \
      || "$arg" -h 2>/dev/null \
      || "$arg" --help 2>/dev/null \
      || help "$arg" 2>/dev/null \
      || xdg-open "https://manned.org/browse/search?q=${arg}" 2>/dev/null
  done
}

cmdfu() {
  local q enc
  q="$*"
  enc=$(printf '%s' "$q" | base64 -w0 2>/dev/null || printf '%s' "$q" | base64)
  curl -sL "https://www.commandlinefu.com/commands/matching/${q// /-}/${enc}/plaintext" \
    | sed 's/\(^#.*\)/\x1b[32m\1\x1b[0m/g' \
    | less -R
}

