# General shell functions

#-------- GRUB {{{

update-grub() { sudo grub-mkconfig -o /boot/grub/grub.cfg; }
grub-update() { update-grub; }

grub-list() {
  sudo grep "menuentry '" /boot/grub/grub.cfg | less -N
  print -P "%F{red}REMINDER: GRUB numbers start at 0%f"
}

