#-------- Images (ImageMagick) {{{

image-resizer() {
  if [ $# -lt 2 ]; then
    echo "Usage: image-resizer <WxH> <image>..."
    return 1
  fi
  local size="$1" arg
  shift
  for arg in "$@"; do
    convert "$arg" -resize "$size" "${arg%.*}_${size}_resized.${arg##*.}"
  done
}

image-rotate() {
  if [ $# -lt 2 ]; then
    echo "Usage: image-rotate <90|180|270> <image>..."
    return 1
  fi
  local deg="$1" arg
  shift
  for arg in "$@"; do
    convert "$arg" -rotate "$deg" "${arg%.*}_${deg}_rotated.${arg##*.}"
  done
}

