#-------- System info {{{

m-sound() {
  arecord -L
  arecord -l
  cat /proc/asound/pcm
}

m-ip() {
  echo "--------------- Network Information ---------------"
  if command -v ip >/dev/null 2>&1; then
    echo "default route:"
    ip -4 route show default 2>/dev/null
    echo
    ip -br addr
    echo
    ip -br link
  fi
  echo "external ip: $(curl -s --max-time 3 http://ipecho.net/plain 2>/dev/null)"
  echo "---------------------------------------------------"
}

