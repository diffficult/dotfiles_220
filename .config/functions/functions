#-------- Filename cleanup {{{

# FOO BAR LinuX.TAR.GZ → foo_bar_linux.tar.gz
detox-unix() {
  local arg filter_name
  for arg in "$@"; do
    filter_name=$(printf '%s' "$arg" | sed 's/%20/ /g; s/ /_/g' | tr '[:upper:]' '[:lower:]')
    mv -- "$arg" "$filter_name"
  done
}

# FOO BAR LinuX.tar.gz → FOO_BAR_LINUX.tar.gz (extension lowercased kept simple)
detox-unixCAP() {
  local arg base ext filter_name
  for arg in "$@"; do
    base=${arg%.*}
    ext=${arg##*.}
    if [ "$base" = "$arg" ]; then
      filter_name=$(printf '%s' "$arg" | sed 's/%20/ /g; s/ /_/g' | tr '[:lower:]' '[:upper:]')
    else
      filter_name=$(printf '%s' "$base" | sed 's/%20/ /g; s/ /_/g' | tr '[:lower:]' '[:upper:]')
      filter_name="${filter_name}.$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"
    fi
    mv -- "$arg" "$filter_name"
  done
}

# FOO BAR LinuX → Foo Bar Linux (bash/zsh title-ish)
detox-human() {
  local arg filter_name
  for arg in "$@"; do
    filter_name=$(printf '%s' "$arg" | sed 's/%20/ /g; s/_/ /g' | tr '[:upper:]' '[:lower:]')
    # capitalize words (zsh/bash)
    filter_name=$(printf '%s' "$filter_name" | sed -E 's/(^| )([a-z])/\1\u\2/g')
    mv -- "$arg" "$filter_name"
  done
}

detox-human-dash() {
  local arg filter_name
  for arg in "$@"; do
    filter_name=$(printf '%s' "$arg" | sed 's/%20/ /g; s/_/ /g; s/-/ /g' | tr '[:upper:]' '[:lower:]')
    filter_name=$(printf '%s' "$filter_name" | sed -E 's/(^| )([a-z])/\1\u\2/g')
    mv -- "$arg" "$filter_name"
  done
}

detox-video() {
  if [ $# -lt 1 ]; then
    echo "Usage: detox-video <video>..."
    return 1
  fi
  local arg duration filesize resolution mime
  for arg in "$@"; do
    mime=$(file --mime-type -b "$arg" | cut -d/ -f1)
    [ "$mime" = "video" ] || continue
    duration=$(ffprobe -v error -show_entries format=duration -of default=nk=1:nw=1 "$arg" 2>/dev/null \
      | awk '{printf "%dh%02dm%02ds", $1/3600, ($1%3600)/60, $1%60}')
    filesize=$(du -h "$arg" | awk '{print $1}')
    resolution=$(ffprobe -v error -select_streams v:0 -show_entries stream=height -of csv=p=0 "$arg" 2>/dev/null)
    mv -- "$arg" "${arg%.*} [${duration},${filesize},${resolution}p].${arg##*.}"
  done
}

