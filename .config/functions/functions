#-------- Webcam (mpv + v4l2) {{{

webcam-list() {
  v4l2-ctl --list-formats-ext
  v4l2-ctl --list-devices
}

webcam() {
  local dev="${1:-/dev/video0}"
  mpv "av://v4l2:${dev}" --profile=low-latency --untimed --no-resume-playback
}

