#-------- Misc utilities {{{

view_csv_pretty() {
  if [ -z "$1" ]; then
    echo "Usage: view_csv_pretty <file.csv>"
    return 1
  fi
  column -s, -t <"$1" | less -F -S -X -K
}

recently_modified() {
  local recent_file
  recent_file=$(/usr/bin/ls -t 2>/dev/null | head -n1)
  if [ -n "$recent_file" ]; then
    echo "Most recently modified: $recent_file"
  else
    echo "No files here" >&2
    return 1
  fi
}

compress_files() {
  if [ $# -lt 2 ]; then
    echo "Usage: compress_files <archive.zip> <file>..."
    return 1
  fi
  zip -r "$1" "${@:2}"
}

search_text_in_files() {
  if [ $# -lt 2 ]; then
    echo "Usage: search_text_in_files <directory> <term>"
    return 1
  fi
  grep -rnw "$1" -e "$2"
}

process_with_most_memory() {
  ps -eo pid,ppid,cmd,%mem,%cpu --sort=-%mem | head
}

list_open_ports() {
  ss -tuln
}

find_listening_ports() {
  if [ -z "$1" ]; then
    echo "Usage: find_listening_ports <pattern>"
    return 1
  fi
  ss -tulnp | grep -- "$1"
}

