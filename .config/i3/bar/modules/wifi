#!/bin/bash
# Combined SSID + signal quality for i3blocks

INTERFACE="${BLOCK_INSTANCE:-wlan0}"

case "${BLOCK_BUTTON:-}" in
	1) # left: network menu
		~/.config/i3/rofi/bin/network_menu &
		;;
	2|3) # middle/right: nm-connection-editor or nmtui
		if command -v nm-connection-editor >/dev/null 2>&1; then
			nm-connection-editor &
		else
			st -n impala-terminal -e nmtui &
		fi
		;;
esac

[[ ! -d /sys/class/net/${INTERFACE}/wireless ]] && exit 0
[[ "$(cat /sys/class/net/$INTERFACE/operstate 2>/dev/null)" = 'down' ]] && {
	echo " down"
	echo ""
	echo "#FF0000"
	exit 0
}

SSID=$(iw dev "$INTERFACE" link 2>/dev/null | awk -F': ' '/SSID/ {print $2; exit}')
QUALITY=$(awk -v iface="$INTERFACE" '$1 ~ iface { print int($3 * 100 / 70); exit }' /proc/net/wireless)

[[ -z "$SSID" ]] && SSID="?"
[[ -z "$QUALITY" ]] && QUALITY=0

if [[ ${#SSID} -gt 16 ]]; then
	SSID="${SSID:0:15}…"
fi

echo " ${SSID} ${QUALITY}%"
echo " ${QUALITY}%"

if [[ $QUALITY -ge 80 ]]; then
	echo "#00FF00"
elif [[ $QUALITY -ge 60 ]]; then
	echo "#C9CCDB"
elif [[ $QUALITY -ge 40 ]]; then
	echo "#FFAE00"
else
	echo "#FF0000"
fi
