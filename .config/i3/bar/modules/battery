# Battery block for i3blocks — click opens power settings / powermenu

use strict;
use warnings;
use utf8;

my $acpi;
my $status;
my $percent;
my $full_text;
my $short_text;
my $bat_number = $ENV{BLOCK_INSTANCE} || 0;
my $button = $ENV{BLOCK_BUTTON} // '';

if ($button eq '1') {
	# left: xfce power settings if available
	if (system('command -v xfce4-power-manager-settings >/dev/null 2>&1') == 0) {
		system('xfce4-power-manager-settings >/dev/null 2>&1 &');
	} else {
		system("$ENV{HOME}/.config/i3/bin/powermenu.sh >/dev/null 2>&1 &");
	}
} elsif ($button eq '3') {
	# right: power menu
	system("$ENV{HOME}/.config/i3/bin/powermenu.sh >/dev/null 2>&1 &");
} elsif ($button eq '2') {
	# middle: detailed acpi notify
	my $detail = `acpi -b 2>/dev/null`;
	chomp $detail;
	system('dunstify', '-u', 'low', '-h', 'string:x-dunst-stack-tag:battery',
		'Battery', $detail || 'n/a');
}

open (ACPI, "acpi -b | grep 'Battery $bat_number' |") or die;
$acpi = <ACPI>;
close(ACPI);

if ($acpi !~ /: (\w+), (\d+)%/) {
	die "$acpi\n";
}

$status = $1;
$percent = $2;
$full_text = "$percent%";

if ($status eq 'Discharging') {
	if ($percent < 10) {
		$full_text = ' ' . $full_text;
	} elsif ($percent < 25) {
		$full_text = ' ' . $full_text;
	} elsif ($percent <= 50) {
		$full_text = ' ' . $full_text;
	} elsif ($percent <= 75) {
		$full_text = ' ' . $full_text;
	} elsif ($percent < 100) {
		$full_text = ' ' . $full_text;
	}
} elsif ($status eq 'Charging') {
	$full_text = '  ' . $full_text;
}

$short_text = $full_text;

if ($acpi =~ /(\d\d:\d\d):/) {
	$full_text .= " ($1)";
}

use open ":std", ":encoding(UTF-8)";
print "$full_text\n";
print "$short_text\n";

if ($status eq 'Discharging') {
	if ($percent < 20) {
		print "#FF0000\n";
	} elsif ($percent < 40) {
		print "#FFAE00\n";
	} elsif ($percent < 60) {
		print "#FFF600\n";
	} elsif ($percent < 85) {
		print "#A8FF00\n";
	}

	if ($percent <= 10) {
		exit(33);
	}
}

exit(0);
