# Modular layout — pieces live in config.d/
#   01-startup  02-options  03-workspaces  04-windows
#   05-binds    06-modes    07-appearance  08-bar

# Variables (must load before includes)
set $mod Mod4
set $alt Mod1

set $terminal ~/.config/i3/bin/i3term.sh
set $drawterm ~/.config/i3/bin/draw_area.sh
set $volume ~/.config/i3/bin/i3volume.sh
set $brightness ~/.config/i3/bin/i3brightness.sh
set $lock ~/.config/i3/bin/lock.sh
set $lock_font Iosevka Nerd Font Mono
set $file_manager nemo
set $text_editor code
set $web_browser zen-browser

set $ws_1 "1: "
set $ws_2 "2: "
set $ws_3 "3: "
set $ws_4 "4: "
set $ws_5 "5: "
set $ws_6 "6: "
set $ws_7 "7: "
set $ws_8 "8: "
set $ws_9 "9: "
set $ws_10 "10: "

set $send-notify exec --no-startup-id dunstify -u low -h string:x-dunst-stack-tag:i3config

include ~/.config/i3/config.d/*.conf
